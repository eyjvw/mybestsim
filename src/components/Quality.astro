---
import { formatInt } from "../lib/format";
import type { QualityReport } from "../lib/types";

interface Props {
  quality: QualityReport;
}

const { quality } = Astro.props;
const figures = [
  ["Fichiers lus", quality.files],
  ["Lignes lues", quality.rows],
  ["Lignes valides", quality.valid],
  ["Lignes rejetées", quality.rejected.length],
] as const;
---

<section id="quality" aria-labelledby="quality-title" class="scroll-mt-28">
  <h2 id="quality-title" class="text-lg font-semibold tracking-tight">Qualité des données</h2>
  <p class="mt-1 max-w-3xl text-sm text-ink-2">
    Contrôle effectué à chaque build sur les CSV fournisseurs. Les mêmes règles tournent en CI : un import invalide
    bloque le déploiement.
  </p>
  <div class="mt-4 grid gap-4 lg:grid-cols-[2fr_3fr]">
    <dl class="grid grid-cols-2 gap-3">
      {
        figures.map(([label, value]) => (
          <div class="rounded-xl border border-line bg-surface p-4">
            <dd class="text-2xl font-semibold tabular-nums">{formatInt(value)}</dd>
            <dt class="text-xs text-ink-3">{label}</dt>
          </div>
        ))
      }
    </dl>
    <div class="rounded-xl border border-line bg-surface p-4">
      {
        quality.rejected.length === 0 ? (
          <p class="text-sm">
            <span class="font-semibold">Aucune ligne rejetée.</span>
            <span class="text-ink-2">
              Colonnes, types, devise, réseau, cohérence volume/libellé et unicité des SKU sont conformes dans les{" "}
              {quality.files} fichiers.
            </span>
          </p>
        ) : (
          <ul class="space-y-1 text-sm">
            {quality.rejected.map((r) => (
              <li>
                <code class="text-ink-2">
                  {r.file}:{r.line}
                </code>{" "}
                {r.reason}
              </li>
            ))}
          </ul>
        )
      }
      <details class="mt-3 text-sm">
        <summary class="cursor-pointer text-ink-2">Détail par fichier</summary>
        <ul class="mt-2 grid grid-cols-2 gap-x-4 gap-y-0.5 sm:grid-cols-3">
          {
            quality.perFile.map((f) => (
              <li class="flex justify-between gap-2 text-xs" title={f.provider}>
                <code class="truncate text-ink-2">{f.file}</code>
                <span class="tabular-nums">
                  {formatInt(f.valid)}/{formatInt(f.rows)}
                </span>
              </li>
            ))
          }
        </ul>
      </details>
    </div>
  </div>
</section>
