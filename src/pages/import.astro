---
import ImportPreview from "../components/ImportPreview";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Layout from "../layouts/Layout.astro";
import { SAMPLE_CHANGES } from "../lib/sample";
---

<Layout
  title="Tester un import · Tableau de bord MyBestSim"
  description="Déposez un fichier fournisseur pour voir, avant l'import, les lignes rejetées, les prix modifiés et les anomalies."
>
  <div class="mx-auto max-w-[1720px] px-4 pb-16 sm:px-6 lg:px-10 2xl:px-14">
    <SiteHeader current="/import" />
    <header class="pt-8 pb-6 lg:pt-10">
      <h1 class="text-3xl leading-[1.1] font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Tester un <em class="text-accent">import</em>
      </h1>
      <p class="mt-3 max-w-3xl text-[15px] text-ink-2">
        MyBestSim importe chaque jour un fichier par fournisseur. Avant qu'un fichier n'arrive dans le catalogue, cette
        page montre ce qu'il changerait : lignes rejetées par le validateur, offres ajoutées ou retirées, prix modifiés et
        anomalies, comparés aux offres en ligne. C'est le même code que le build et
        que le rapport posté par la CI sur chaque PR de données.
      </p>
    </header>
    <ImportPreview client:load sampleUrl="/exemple-import.csv" validSampleUrl="/exemple-import-valide.csv" />
    <p class="mt-10 text-xs text-ink-3">
      Exemple : {SAMPLE_CHANGES.repriced} prix modifiés, {SAMPLE_CHANGES.removed} offres retirées,{" "}
      {SAMPLE_CHANGES.added} ajoutées, {SAMPLE_CHANGES.invalid} lignes invalides (devise USD, prix négatif). Un export CSV du tableau de bord se
      réimporte ici tel quel.
    </p>
    <SiteFooter />
  </div>
</Layout>
