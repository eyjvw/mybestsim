---
import Dashboard from "../components/Dashboard";
import Decisions from "../components/Decisions.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Layout from "../layouts/Layout.astro";
import { loadCatalog } from "../lib/load";
import { dashboardProps } from "../lib/page-props";
import { PRICE_THRESHOLD } from "../lib/stats";

const props = dashboardProps();
// Offers priced exactly at the 100 € threshold (none today: the choice changes nothing yet).
const atThreshold = loadCatalog().products.filter((p) => p.price === PRICE_THRESHOLD).length;
---

<Layout title="Qualité · Tableau de bord MyBestSim" description="Le contrôle de chaque import, les points qu'un humain doit vérifier, et les choix assumés quand le sujet laissait une question ouverte.">
  <div class="mx-auto max-w-[1720px] px-4 pb-16 sm:px-6 lg:px-10 2xl:px-14">
    <SiteHeader current="/qualite" />
    <main>
      <header class="pt-8 pb-6 lg:pt-10">
        <h1 class="text-3xl leading-[1.1] font-bold tracking-tight sm:text-4xl lg:text-5xl">
          Qualité des <em class="text-accent">données</em>
        </h1>
        <p class="mt-3 max-w-3xl text-[15px] text-ink-2">Le contrôle de chaque import, les points qu'un humain doit vérifier, et les choix assumés quand le sujet laissait une question ouverte.</p>
      </header>
      <Dashboard client:afterpaint view="quality" {...props} />
      <div class="mt-12">
        <Decisions
          unlimited={props.initialStats.data.unlimited}
          atThreshold={atThreshold}
          duplicates={props.initialAudit.duplicates.count}
        />
      </div>
    </main>
    <SiteFooter />
  </div>
</Layout>
