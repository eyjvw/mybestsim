    <!-- Highlights the section being read in the side table of contents: the last heading
         that has scrolled past the top third of the screen. -->
    <script is:inline>
      (() => {
        const links = [...document.querySelectorAll("[data-toc-side] a")];
        const heads = links.map((a) => document.getElementById(a.hash.slice(1)));
        let frame = 0;
        const mark = () => {
          frame = 0;
          let current = -1;
          heads.forEach((h, i) => {
            if (h && h.getBoundingClientRect().top < innerHeight / 3) current = i;
          });
          links.forEach((a, i) =>
            i === current ? a.setAttribute("aria-current", "location") : a.removeAttribute("aria-current"),
          );
        };
        addEventListener("scroll", () => (frame ||= requestAnimationFrame(mark)), { passive: true });
        // First mark after the first paint, when the layout is already computed: called during
        // parsing, it forced a layout of the whole article before anything was on screen.
        requestAnimationFrame(() => setTimeout(mark));
      })();
    </script>
