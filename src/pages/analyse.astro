---
import Dashboard from "../components/Dashboard";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Layout from "../layouts/Layout.astro";
import { dashboardProps } from "../lib/page-props";

const props = dashboardProps();
---

<Layout title="Analyse · Tableau de bord MyBestSim" description="Point 7 du sujet : prix au Go, prix selon le volume, distribution des prix, profil des offres, puis ce que la comparaison fait économiser.">
  <div class="mx-auto max-w-[1720px] px-4 pb-16 sm:px-6 lg:px-10 2xl:px-14">
    <SiteHeader current="/analyse" />
    <header class="pt-8 pb-6 lg:pt-10">
      <h1 class="text-3xl leading-[1.1] font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Analyse et <em class="text-accent">économies</em>
      </h1>
      <p class="mt-3 max-w-3xl text-[15px] text-ink-2">Point 7 du sujet : prix au Go, prix selon le volume, distribution des prix, profil des offres, puis ce que la comparaison fait économiser.</p>
    </header>
    <Dashboard client:load view="analysis" {...props} />
    <SiteFooter />
  </div>
</Layout>
