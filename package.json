{
  "name": "mybestsim-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bunx --bun astro dev",
    "build": "bunx --bun astro build",
    "preview": "bunx --bun astro preview",
    "check": "bunx --bun astro check",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "validate": "bun scripts/validate-data.ts",
    "test": "bun test",
    "data-report": "bun scripts/data-report.ts",
    "ingest": "bun server/main.ts",
    "import": "bun scripts/import.ts",
    "dev:live": "bun run build && STATIC_DIR=dist PORT=4322 HOST=127.0.0.1 INGEST_TOKEN=dev-token-not-for-production INBOX_INTERVAL_MS=2000 bun server/main.ts --ephemeral"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "@fontsource/poppins": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.2",
    "@types/bun": "1.4.4",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3"
  }
}
