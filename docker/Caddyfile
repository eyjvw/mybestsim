# Serves the built site inside the container. TLS and security headers are
# handled by the reverse proxy in front of it.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# Hashed build assets never change: cache them for a year.
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Data and version change on every deploy: always revalidate.
	@fresh path /catalog.json /stats.json /version.json /
	header @fresh Cache-Control "no-cache"

	file_server
}
