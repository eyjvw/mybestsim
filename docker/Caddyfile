# Serves the built site inside the container. TLS and security headers are handled by
# the reverse proxy in front of it. Live data comes from the ingest service's volume,
# mounted read-only on /data; publishing goes to the ingest container.
{
	admin off
	auto_https off
	# Trust the VPS proxy (Docker network, private range): X-Forwarded-For then starts with the
	# real client, which the ingest service uses for its rate limits.
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# Publishing API: ingest service (validation, guard, atomic releases, webhook).
	handle /api/* {
		request_body {
			max_size 6MB
		}
		reverse_proxy {$INGEST_UPSTREAM:ingest:3000}
	}

	# Live data: the current release of the volume, always revalidated.
	handle_path /data/* {
		root * /data/current
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		root * /srv

		# Hashed build assets never change: cache them for a year.
		@assets path /_astro/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Build snapshot and pages change on every deploy: always revalidate.
		@fresh path /catalog.json /stats.json /version.json /
		header @fresh Cache-Control "no-cache"

		file_server
	}
}
